<%- include('../partials/head') %>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 py-12">
      <!-- Header -->
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Explore Our Properties
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Find the perfect place for your next stay from our carefully curated collection
        </p>
      </div>

      <!-- Properties Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition duration-300 overflow-hidden transform hover:-translate-y-2 group">
            <!-- Image Container -->
            <div class="relative overflow-hidden h-64 bg-gray-200">
              <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-300">
              <div class="absolute top-4 right-4 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-semibold">⭐ <%= home.rating %>/5</div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <h3 class="text-2xl font-bold text-gray-900 mb-1"><%= home.houseName %></h3>
              <p class="text-sm text-gray-600 mb-4 flex items-center gap-2">
                <span>📍</span><%= home.address %>
              </p>
              
              <div class="border-t border-b border-gray-200 py-4 mb-4">
                <p class="text-sm text-gray-600 mb-2"><strong>Location:</strong> <%= home.location %></p>
              </div>

              <div class="flex justify-between items-center mb-6">
                <div>
                  <p class="text-sm text-gray-600">Starting from</p>
                  <p class="text-3xl font-bold text-red-500">$<%= home.price %><span class="text-sm text-gray-600">/night</span></p>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="space-y-2">
                <a href="/homes/<%= home._id %>" class="block w-full bg-gradient-to-r from-red-500 to-orange-500 text-white font-bold py-2.5 px-4 rounded-lg hover:from-red-600 hover:to-orange-600 transition duration-300 text-center shadow-md hover:shadow-lg transform hover:scale-105 active:scale-100">
                  👁️ View Details
                </a>
                <div class="flex gap-2">
                  <div class="flex-1">
                    <%- include('../partials/favourite',{home:home}) %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
