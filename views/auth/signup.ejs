<%- include('../partials/head') %>
<body class="bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
  <%- include('../partials/nav') %>
  <main class="min-h-screen flex items-center justify-center px-4 py-8 md:py-12">
    <div class="w-full max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        
        <!-- Left Side - Branding -->
        <div class="hidden md:flex flex-col justify-center text-white">
          <h2 class="text-5xl font-bold mb-6">Welcome!</h2>
          <p class="text-lg text-gray-300 mb-8 leading-relaxed">
            Join thousands of travelers and hosts discovering amazing experiences on our platform.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-xl">🌍</span>
              </div>
              <div>
                <h3 class="font-semibold text-lg">Explore Worldwide</h3>
                <p class="text-gray-400 text-sm">Discover properties across the globe</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-orange-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-xl">🔒</span>
              </div>
              <div>
                <h3 class="font-semibold text-lg">Secure & Safe</h3>
                <p class="text-gray-400 text-sm">Your data is encrypted and protected</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-xl">💬</span>
              </div>
              <div>
                <h3 class="font-semibold text-lg">24/7 Support</h3>
                <p class="text-gray-400 text-sm">We're here to help you anytime</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side - Form -->
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
          <!-- Decorative Header Bar -->
          <div class="h-2 bg-gradient-to-r from-red-500 via-orange-500 to-red-500"></div>
          
          <div class="p-8 md:p-10">
            <!-- Header -->
            <div class="mb-8">
              <h1 class="text-3xl font-bold text-gray-900 mb-2">Create Account</h1>
              <p class="text-gray-600">Start your journey with us today</p>
            </div>

            <form action="/signup" method="POST" class="space-y-5">
              
            <%- include('../partials/errors') %>

              <!-- Name Row -->
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="firstName" class="block text-sm font-semibold text-gray-800 mb-2">First Name</label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName" 
                    placeholder="John" 
                    value="<%=oldInput.firstName? oldInput.firstName : '' %>"
                    required
                    class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition duration-200 text-gray-900 placeholder-gray-400 font-medium"/>
                </div>
                <div>
                  <label for="lastName" class="block text-sm font-semibold text-gray-800 mb-2">Last Name</label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName" 
                    placeholder="Doe" 
                    value="<%=oldInput.lastName? oldInput.lastName : '' %>"
                    class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition duration-200 text-gray-900 placeholder-gray-400 font-medium"/>
                </div>
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-semibold text-gray-800 mb-2">Email Address</label>
                <input
                  type="email"
                  id="email"
                  name="email" 
                  placeholder="you@example.com" 
                  value="<%=oldInput.email? oldInput.email : '' %>"
                  required
                  class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition duration-200 text-gray-900 placeholder-gray-400 font-medium"/>
              </div>

              <!-- Password -->
              <div>
                <label for="password" class="block text-sm font-semibold text-gray-800 mb-2">Password</label>
                <input 
                  type="password" 
                  id="password"
                  name="password" 
                  placeholder="Create a strong password" 
                  class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition duration-200 text-gray-900 placeholder-gray-400 font-medium" 
                  required/>
                <p class="text-xs text-gray-500 mt-2 flex items-center gap-1">
                  <span>✓</span> Minimum 8 characters recommended
                </p>
              </div>

              <!-- Confirm Password -->
              <div>
                <label for="confirmPassword" class="block text-sm font-semibold text-gray-800 mb-2">Confirm Password</label>
                <input 
                  type="password" 
                  id="confirmPassword"
                  name="confirmPassword" 
                  placeholder="Re-enter your password" 
                  class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition duration-200 text-gray-900 placeholder-gray-400 font-medium" 
                  required/>
              </div>

              <!-- Account Type Selection -->
              <div class="pt-2">
                <label class="block text-sm font-semibold text-gray-800 mb-3">I want to:</label>
                <div class="space-y-3">
                  <!-- Guest Option -->
                  <div class="relative">
                    <input 
                      type="radio" 
                      name="userType" 
                      value="guest"
                      id="guest"
                      class="hidden peer"
                      checked=" <% oldInput.userType === "guest" %>"/>
                    <label for="guest" class="flex items-center p-4 border-2 border-gray-200 rounded-xl cursor-pointer peer-checked:border-red-500 peer-checked:bg-red-50 hover:border-red-300 transition duration-200 group">
                      <div class="w-5 h-5 border-2 border-gray-300 rounded-full peer-checked:border-red-500 peer-checked:bg-red-500 flex items-center justify-center mr-4 group-hover:border-red-500 transition duration-200">
                        <span class="hidden peer-checked:block text-white text-xs font-bold">✓</span>
                      </div>
                      <div class="flex-1">
                        <span class="font-semibold text-gray-900 text-sm block">Browse & Book Properties</span>
                        <p class="text-xs text-gray-600 mt-0.5">Discover and reserve amazing homes as a guest</p>
                      </div>
                      <span class="text-2xl group-hover:scale-110 transition duration-200">🏠</span>
                    </label>
                  </div>

                  <!-- Host Option -->
                  <div class="relative">
                    <input 
                      type="radio" 
                      name="userType" 
                      value="host"
                      id="host"
                      class="hidden peer"
                      />
                    <label for="host" class="flex items-center p-4 border-2 border-gray-200 rounded-xl cursor-pointer peer-checked:border-orange-500 peer-checked:bg-orange-50 hover:border-orange-300 transition duration-200 group">
                      <div class="w-5 h-5 border-2 border-gray-300 rounded-full peer-checked:border-orange-500 peer-checked:bg-orange-500 flex items-center justify-center mr-4 group-hover:border-orange-500 transition duration-200">
                        <span class="hidden peer-checked:block text-white text-xs font-bold">✓</span>
                      </div>
                      <div class="flex-1">
                        <span class="font-semibold text-gray-900 text-sm block">List & Manage Properties</span>
                        <p class="text-xs text-gray-600 mt-0.5">Start earning by sharing your space as a host</p>
                      </div>
                      <span class="text-2xl group-hover:scale-110 transition duration-200">🔑</span>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Terms and Conditions -->
              <div class="pt-2">
                <div class="flex items-start gap-3 p-4 bg-blue-50 border-l-4 border-blue-500 rounded-lg hover:bg-blue-100 transition duration-200">
                  <input 
                    type="checkbox" 
                    name="terms" 
                    id="terms"
                    class="w-5 h-5 text-red-500 rounded cursor-pointer mt-0.5 flex-shrink-0 accent-red-500" 
                    required/> 
                  <label for="terms" class="text-sm text-gray-700 cursor-pointer leading-relaxed">
                    I agree to the <a href="#" class="font-bold text-red-600 hover:underline">Terms of Service</a> and <a href="#" class="font-bold text-red-600 hover:underline">Privacy Policy</a>
                  </label>
                </div>
              </div>

              <!-- Submit Button -->
              <button 
                type="submit" 
                class="w-full bg-gradient-to-r from-red-500 to-orange-500 text-white font-bold py-3.5 px-4 rounded-lg hover:from-red-600 hover:to-orange-600 transition duration-300 shadow-lg hover:shadow-xl mt-8 transform hover:scale-105 active:scale-100 flex items-center justify-center gap-2">
                <span>🎉</span> Create Account
              </button>

              <!-- Divider -->
              <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-gray-300"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                  <span class="px-2 bg-white text-gray-500 font-medium">or</span>
                </div>
              </div>

              <!-- Social Signup -->
              <div class="grid grid-cols-2 gap-3">
                <button type="button" class="flex items-center justify-center gap-2 px-4 py-3 border-2 border-gray-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 transition duration-200 text-gray-700 font-semibold text-sm group">
                  <span class="text-xl group-hover:scale-110 transition duration-200">🔵</span> Google
                </button>
                <button type="button" class="flex items-center justify-center gap-2 px-4 py-3 border-2 border-gray-200 rounded-lg hover:border-blue-600 hover:bg-blue-50 transition duration-200 text-gray-700 font-semibold text-sm group">
                  <span class="text-xl group-hover:scale-110 transition duration-200">f</span> Facebook
                </button>
              </div>
            </form>

            <!-- Login Link -->
            <div class="text-center mt-8 pt-6 border-t border-gray-200">
              <p class="text-gray-700 text-sm">
                Already have an account? 
                <a href="/login" class="font-bold text-red-500 hover:text-red-600 transition duration-200 underline">
                  Sign In
                </a>
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</body>
</html>
