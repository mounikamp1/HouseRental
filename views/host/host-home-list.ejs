<%- include('../partials/head') %>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 py-12">
      <!-- Header -->
      <div class="flex justify-between items-center mb-12">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-2">
            🔑 Your Properties
          </h2>
          <p class="text-lg text-gray-600">
            Manage your registered properties here
          </p>
        </div>
        <a href="/host/add-home" class="bg-gradient-to-r from-red-500 to-orange-500 text-white font-bold py-3 px-6 rounded-lg hover:from-red-600 hover:to-orange-600 transition duration-300 shadow-lg hover:shadow-xl transform hover:scale-105 active:scale-100 whitespace-nowrap">
          ➕ Add New Property
        </a>
      </div>

      <!-- Properties Grid -->
      <% if(registeredHomes && registeredHomes.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition duration-300 overflow-hidden group">
            <!-- Image Container -->
            <div class="relative overflow-hidden h-64 bg-gray-200">
              <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-300">
              <div class="absolute top-4 right-4 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-semibold">⭐ <%= home.rating %>/5</div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <h3 class="text-2xl font-bold text-gray-900 mb-1"><%= home.houseName %></h3>
              <p class="text-sm text-gray-600 mb-4 flex items-center gap-2">
                <span>📍</span><%= home.address %>
              </p>
              
              <div class="border-t border-b border-gray-200 py-4 mb-4">
                <p class="text-sm text-gray-600 mb-2"><strong>Location:</strong> <%= home.location %></p>
              </div>

              <div class="flex justify-between items-center mb-6">
                <div>
                  <p class="text-sm text-gray-600">Price per night</p>
                  <p class="text-3xl font-bold text-red-500">$<%= home.price %></p>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="space-y-2 grid grid-cols-2 gap-2">
                <a href="/host/edit-home/<%=home._id%>?editing=true" class="bg-blue-500 text-white font-bold py-2.5 px-4 rounded-lg hover:bg-blue-600 transition duration-300 text-center text-sm">
                  ✏️ Edit
                </a>
                <form action="/host/delete-home/<%= home._id%>" method="POST" class="flex-1">
                  <button type="submit" class="w-full bg-red-500 text-white font-bold py-2.5 px-4 rounded-lg hover:bg-red-600 transition duration-300 text-sm" onclick="return confirm('Are you sure you want to delete this property?');">
                    🗑️ Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="bg-white rounded-2xl shadow-lg p-12 text-center max-w-2xl mx-auto">
        <div class="text-6xl mb-6">🏠</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">No Properties Yet</h3>
        <p class="text-lg text-gray-600 mb-8">
          You haven't added any properties yet. Start earning by listing your first property today!
        </p>
        <a href="/host/add-home" class="inline-block bg-gradient-to-r from-red-500 to-orange-500 text-white font-bold py-3 px-8 rounded-lg hover:from-red-600 hover:to-orange-600 transition duration-300 shadow-lg hover:shadow-xl transform hover:scale-105 active:scale-100">
          ➕ Add Your First Property
        </a>
      </div>
      <% } %>
    </main> 
  </body>
</html>
